# Postgres connection string — get this from your Neon / Supabase / Railway dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Port the API listens on (defaults to 3000 if unset)
PORT=3000

# Allowed CORS origin for your frontend (set to your Vite dev server or deployed URL)
# Leave unset to allow all origins (fine for local dev, lock down for production)
FRONTEND_ORIGIN=http://localhost:5173

# Flash integration — outbound notify when a facility clears all open receiving
# (see "External Integrations" in README). Contract confirmed by Flash 2026-08-21:
# POST {facilityId, deliveryDate, keyParam: 'GRN_ALLOWED', valueParam: '1'} with HTTP
# Basic auth. Leave FLASH_OUTBOUND_URL unset to disable the integration.
FLASH_OUTBOUND_URL=
FLASH_OUTBOUND_USERNAME=
FLASH_OUTBOUND_PASSWORD=
