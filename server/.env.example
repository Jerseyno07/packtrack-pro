# Postgres connection string — get this from your Neon / Supabase / Railway dashboard
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Port the API listens on (defaults to 3000 if unset)
PORT=3000

# Allowed CORS origin for your frontend (set to your Vite dev server or deployed URL)
# Leave unset to allow all origins (fine for local dev, lock down for production)
FRONTEND_ORIGIN=http://localhost:5173

# Flash integration — outbound notify when a facility clears all open receiving
# (see "External Integrations" in README). Contract confirmed by Flash 2026-08-21:
# POST {facilityId, deliveryDate, keyParam: 'GRN_ALLOWED', valueParam: '1'} with HTTP
# Basic auth. Leave FLASH_OUTBOUND_URL unset to disable the integration.
FLASH_OUTBOUND_URL=
FLASH_OUTBOUND_USERNAME=
FLASH_OUTBOUND_PASSWORD=

# Google SSO login — Admin Portal + PM Store Ops only (phase 1). Requires a Google
# Cloud OAuth 2.0 "Web application" Client ID (no client secret needed for the
# ID-token verification flow this app uses). Leave GOOGLE_CLIENT_ID unset to
# disable Google sign-in entirely (the button simply won't render, email+password
# keeps working everywhere). GOOGLE_WORKSPACE_DOMAIN restricts sign-in to that
# Google Workspace domain (checked server-side, not just client-side) — leave
# unset to skip the domain check (not recommended in production).
GOOGLE_CLIENT_ID=
GOOGLE_WORKSPACE_DOMAIN=ninjacart.com

# Invite emails, sent automatically when an admin invites a Google-authed user.
# Sent via Gmail SMTP using an existing Google account + an App Password (Account
# Settings -> Security -> 2-Step Verification -> App Passwords) — no domain/DNS
# verification needed, unlike Resend/SES/SendGrid. Requires 2-Step Verification
# enabled on GMAIL_USER's account; some Google Workspace orgs disable App
# Passwords entirely via admin policy, in which case this won't be available.
# Leave both unset to disable (invites still work, just no email sent).
GMAIL_USER=
GMAIL_APP_PASSWORD=
